#!/bin/sh

# PROVIDE: homeflix
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf to enable homeflix:
#
# homeflix_enable (bool):  Set to "YES" to run homeflix. Default: "NO".
# homeflix_config (path):  Configuration file, see homeflix.conf(5).
#                          Default: "/usr/local/etc/homeflix.conf".
# homeflix_user (str):     Account that runs homeflix and reads the media.
#                          Default: "homeflix".
# homeflix_group (str):    Group of that account. Default: "homeflix".
# homeflix_datadir (path): Must match "data directory" in the configuration.
#                          Default: "/var/db/homeflix".
# homeflix_logfile (path): Server log. Default: "/var/log/homeflix.log".
#
# "service homeflix configtest" checks the configuration; start does so too.

. /etc/rc.subr

name=homeflix
rcvar=homeflix_enable

load_rc_config $name

: ${homeflix_enable:="NO"}
: ${homeflix_config:="/usr/local/etc/homeflix.conf"}
: ${homeflix_user:="homeflix"}
: ${homeflix_group:="homeflix"}
: ${homeflix_datadir:="/var/db/homeflix"}
: ${homeflix_logfile:="/var/log/homeflix.log"}

pidfile="/var/run/${name}/${name}.pid"
procname="/usr/local/bin/homeflix"
command="/usr/sbin/daemon"
command_args="-f -H -p ${pidfile} -o ${homeflix_logfile} -t ${name} ${procname} serve -config ${homeflix_config}"
required_files="${homeflix_config}"
extra_commands="configtest"
configtest_cmd="${name}_configtest"
start_precmd="${name}_prestart"

homeflix_configtest()
{
	echo "Performing sanity check on ${name} configuration:"
	${procname} serve -n -config "${homeflix_config}"
}

homeflix_prestart()
{
	homeflix_configtest || return 1
	install -d -o "${homeflix_user}" -g "${homeflix_group}" -m 0755 "/var/run/${name}"
	install -d -o "${homeflix_user}" -g "${homeflix_group}" -m 0750 "${homeflix_datadir}"
	if [ ! -e "${homeflix_logfile}" ]; then
		install -o "${homeflix_user}" -g "${homeflix_group}" -m 0640 /dev/null "${homeflix_logfile}"
	fi
}

run_rc_command "$1"
